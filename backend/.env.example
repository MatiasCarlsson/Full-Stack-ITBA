# Variables de entorno del backend — Hermanos Jota
# Copiá este archivo como .env y completá los valores. El .env no se sube al repositorio.

# ── Base de datos ───────────────────────────────────────────────────────────────
# Cadena de conexión de MongoDB Atlas. Sale de Atlas en Connect > Drivers.
# Hay que reemplazar <db_password> por la contraseña del usuario de base de datos y poner
# el nombre de la base antes del "?", si no Mongo escribe en una base llamada "test".
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/hermanos-jota?retryWrites=true&w=majority

# ── Servidor ────────────────────────────────────────────────────────────────────
# Puerto local. Render lo define solo, así que en Render no hace falta cargarla.
PORT=3001

# development o production. En production la política de CORS deja de ser permisiva.
NODE_ENV=development

# ── Seguridad ───────────────────────────────────────────────────────────────────
# Clave que exige la API para crear, editar y borrar productos. El panel de admin la pide
# una vez y la manda en la cabecera x-admin-token.
# Generá una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Direcciones que pueden llamar a la API desde un navegador, separadas por coma.
# En producción es obligatoria: si queda vacía, el navegador rechaza las llamadas del
# frontend. En desarrollo, si queda vacía, se permite cualquier origen.
ORIGENES_PERMITIDOS=http://localhost:3000,https://full-stack-itba-ecru.vercel.app
